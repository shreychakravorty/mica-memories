{
  "name": "Person",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "email_aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_batch_member": {
      "type": "boolean",
      "default": true
    },
    "received_count": {
      "type": "number",
      "default": 0
    },
    "written_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}