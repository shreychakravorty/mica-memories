{
  "name": "MediaSetting",
  "type": "object",
  "properties": {
    "jellyfin_url": {
      "type": "string"
    },
    "jellyfin_api_key": {
      "type": "string"
    },
    "jellyfin_user_id": {
      "type": "string"
    }
  },
  "rls": {
    "read": false,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}